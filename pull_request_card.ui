<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk" version="4.0"/>

  <object class="GtkBox" id="card">
    <property name="orientation">vertical</property>
    <property name="spacing">8</property>

    <property name="margin-top">6</property>
    <property name="margin-bottom">6</property>
    <property name="margin-start">6</property>
    <property name="margin-end">6</property>

    <style>
      <class name="card"/>
    </style>

    <child>
      <object class="GtkBox" id="content">
        <property name="orientation">vertical</property>
        <property name="spacing">8</property>

        <property name="margin-top">16</property>
        <property name="margin-bottom">16</property>
        <property name="margin-start">16</property>
        <property name="margin-end">16</property>

        <child>
          <object class="GtkLabel" id="title">
            <property name="xalign">0</property>
            <property name="wrap">True</property>
            <property name="wrap-mode">word-char</property>
            <property name="lines">2</property>

            <style>
              <class name="title-3"/>
            </style>
          </object>
        </child>

        <child>
          <object class="GtkLabel" id="details">
            <property name="xalign">0</property>

            <style>
              <class name="dim-label"/>
            </style>
          </object>
        </child>

        <!-- Optional description, corresponding to your commented C code -->
        <!--
        <child>
          <object class="GtkLabel" id="description">
            <property name="xalign">0</property>
            <property name="wrap">True</property>
            <property name="wrap-mode">word-char</property>
            <property name="ellipsize">end</property>
            <property name="lines">3</property>
          </object>
        </child>
        -->

        <child>
          <object class="GtkBox" id="footer">
            <property name="orientation">horizontal</property>
            <property name="halign">end</property>

            <child>
              <object class="GtkLinkButton" id="open_link">
                <property name="label">Open on GitHub</property>
                <property name="uri">https://github.com/</property>

                <style>
                  <class name="flat"/>
                </style>
              </object>
            </child>
          </object>
        </child>
      </object>
    </child>
  </object>
</interface>
